# NoPixel Minigames 4.0 - Environment Variables

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string_here

# Discord OAuth (for user authentication)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-domain.com/api/auth/discord/callback
NEXTAUTH_URL=https://your-domain.com

# Session signing secret: generate with `openssl rand -hex 32`
NEXTAUTH_SECRET=replace_with_at_least_32_random_bytes

# Comma-separated Discord user IDs allowed to reset the daily challenge. Empty denies everyone.
ADMIN_DISCORD_IDS=

# Scheduled guest cleanup authorization
CRON_SECRET=replace_with_a_random_secret

# Google Tag Manager (Optional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Site URL
NEXT_PUBLIC_SITE_URL=https://nphacks.net

# Ably (realtime — powers 1v1 lobby/match WebSockets)
ABLY_API_KEY=your_ably_root_api_key

# Sentry error monitoring (optional). The DSN is a PUBLIC key and is already
# hardcoded as a fallback in sentry.*.config.ts, so this override is optional.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: set to enable source-map upload at build so stack traces are readable.
SENTRY_AUTH_TOKEN=
